# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=Helpdesk
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://helpdesk.example.com
APP_TIMEZONE=UTC

# Footer credit line shown across the UI.
APP_CREDIT="Built with coffee by pradigta"

# Generate with: php artisan key:generate
# (docker compose run --rm app php artisan key:generate)

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=helpdesk
DB_USERNAME=helpdesk
DB_PASSWORD=change-me-strong-password
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Session / Cache / Queue
# ---------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set to true ONLY when the app is served over HTTPS. If true while accessing
# over http:// the browser drops the session cookie and every login fails (419).
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database

# ---------------------------------------------------------------------------
# Filesystem
# ---------------------------------------------------------------------------
FILESYSTEM_DISK=local

# ---------------------------------------------------------------------------
# Ticket attachments
# ---------------------------------------------------------------------------
ATTACHMENT_MAX_SIZE_KB=10240
ATTACHMENT_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp,pdf,txt,log,csv,doc,docx,xls,xlsx,ppt,pptx,zip

# ---------------------------------------------------------------------------
# API (Laravel Sanctum)
# ---------------------------------------------------------------------------
# Leave blank for non-expiring tokens, or set a value in minutes.
SANCTUM_TOKEN_EXPIRATION=
# Comma-separated list of origins allowed to call /api/* from a browser.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Mail (optional - defaults to writing mails to the log)
# ---------------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=helpdesk@example.com
MAIL_FROM_NAME=Helpdesk

# ---------------------------------------------------------------------------
# Initial admin account (used by the database seeder on first deploy)
# ---------------------------------------------------------------------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---------------------------------------------------------------------------
# Docker Compose (compose file reads these)
# ---------------------------------------------------------------------------
APP_PORT=8080
POSTGRES_VOLUME=helpdesk_db_data
